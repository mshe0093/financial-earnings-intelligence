# ============================================================
# Financial Earnings Intelligence — .gitignore
# SECURITY-FIRST: All secrets, data, and caches are excluded.
# ============================================================

# ── Secrets & Environment Files ──
.env
.env.*
*.env
!.env.example

# ── DuckDB Database Files ──
*.duckdb
*.duckdb.wal

# ── Data Directories (raw, cached, processed) ──
data/raw/
data/cache/
data/processed/

# ── Logs ──
logs/

# ── Python Virtual Environments ──
.venv/
venv/
env/
ENV/

# ── Python Bytecode & Cache ──
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ── Jupyter Notebook Checkpoints ──
*.ipynb_checkpoints/
.ipynb_checkpoints/

# ── Distribution & Build ──
dist/
build/
*.egg-info/
*.egg
*.whl

# ── Test & Coverage ──
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/

# ── IDE & Editor ──
.idea/
.vscode/
*.swp
*.swo
*~

# ── OS Artifacts ──
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ── Ruff ──
.ruff_cache/
