# ============================================================
# Financial Earnings Intelligence — Environment Configuration
# ============================================================
#
# INSTRUCTIONS:
#   1. Copy this file to .env:       cp .env.example .env
#   2. Replace ALL placeholder values below with your real credentials.
#   3. NEVER commit the .env file — it is git-ignored by default.
#   4. Verify ignore status:         git check-ignore -v .env
#
# ============================================================

# SEC EDGAR Fair Access — Required format: "AppName contact@email.com"
SEC_USER_AGENT="EarningsApp user@domain.com"

# Google Gemini API Key (https://aistudio.google.com/apikey)
GEMINI_API_KEY="your_api_key_here"

# FRED API Key (https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY="your_api_key_here"

# ── Optional Overrides ──
# DUCKDB_PATH="data/earnings.duckdb"
# LOG_LEVEL="INFO"
# EDGAR_RATE_LIMIT_RPS="8"
